---
import '../styles/global.css';
import { SEO, SITE_URL, FAQ, WHATSAPP_URL } from '../config/site';
import { isProduction } from '../config/env';

interface Props {
  title?: string;
  description?: string;
  /** Path relative to the site root, e.g. "/" — used for the canonical URL. */
  path?: string;
  /** Emit the page-level structured data (home page only). */
  structuredData?: boolean;
  noindex?: boolean;
}

const {
  title = SEO.title,
  description = SEO.description,
  path = '/',
  structuredData = false,
  noindex = false,
} = Astro.props;

const canonical = new URL(path, SITE_URL + '/').href;
const ogImage = `${SITE_URL}/og-image.png`;
const robots = noindex || !isProduction ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';

const jsonLd = structuredData
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Organization',
          '@id': `${SITE_URL}/#organization`,
          name: SEO.name,
          url: SITE_URL,
          logo: `${SITE_URL}/icon-512.png`,
          contactPoint: {
            '@type': 'ContactPoint',
            contactType: 'sales',
            url: WHATSAPP_URL,
            availableLanguage: 'Portuguese',
            areaServed: 'BR',
          },
        },
        {
          '@type': 'WebSite',
          '@id': `${SITE_URL}/#website`,
          url: SITE_URL,
          name: SEO.name,
          inLanguage: 'pt-BR',
          publisher: { '@id': `${SITE_URL}/#organization` },
        },
        {
          '@type': 'SoftwareApplication',
          name: 'Organizae',
          applicationCategory: 'BusinessApplication',
          applicationSubCategory: 'Sistema de gestão de lojas',
          operatingSystem: 'Web',
          inLanguage: 'pt-BR',
          url: SITE_URL,
          description: SEO.description,
          featureList: [
            'PDV para registro de vendas',
            'Controle de estoque',
            'Importação de XML de NF-e de compra',
            'Controle de caixa por operador',
            'Cadastro de clientes, produtos e fornecedores',
            'Controle de despesas',
            'Relatórios de vendas, fechamento de caixa e despesas',
          ],
          publisher: { '@id': `${SITE_URL}/#organization` },
        },
        {
          '@type': 'FAQPage',
          mainEntity: FAQ.map(({ q, a }) => ({
            '@type': 'Question',
            name: q,
            acceptedAnswer: { '@type': 'Answer', text: a },
          })),
        },
      ],
    }
  : null;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />

    <!-- Runs before paint so the chosen theme never flashes. Keep in sync with ThemeToggle. -->
    <script is:inline>
      (() => {
        let theme = null;
        try {
          theme = localStorage.getItem('organizae-theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.classList.toggle('dark', theme === 'dark');
      })();
    </script>

    <meta name="theme-color" media="(prefers-color-scheme: light)" content={SEO.themeLight} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={SEO.themeDark} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={SEO.locale} />
    <meta property="og:site_name" content={SEO.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Organizae — sistema de gestão de lojas" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="min-h-dvh overflow-x-clip">
    <slot />
  </body>
</html>
