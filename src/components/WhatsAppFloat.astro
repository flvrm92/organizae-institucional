---
import WhatsAppIcon from './WhatsAppIcon.astro';
import { WHATSAPP_URL } from '../config/site';
---

<!-- Mobile-only shortcut; on larger screens the header "Contato" button is always visible. -->
<a
  href={WHATSAPP_URL}
  target="_blank"
  rel="noopener"
  aria-label="Falar com o Organizae no WhatsApp"
  class="fixed bottom-5 right-5 z-40 grid h-14 w-14 place-items-center rounded-full bg-[#128c4a] text-white shadow-[0_12px_28px_-8px_rgb(18_140_74/0.7)] transition-transform hover:scale-105 sm:hidden"
>
  <WhatsAppIcon class="h-7 w-7" />
</a>
