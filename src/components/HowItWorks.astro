---
// The three steps are a real sequence (set up → sell → close the day), so they are numbered.
const steps = [
  {
    title: 'Cadastre seus produtos',
    text: 'Informe o custo e a margem: o preço de venda sai calculado. Organize por categorias e subcategorias e cadastre clientes e fornecedores.',
  },
  {
    title: 'Venda pelo PDV',
    text: 'Busque o produto pelo nome, mesmo sem acento, ajuste o preço se precisar e receba em várias formas de pagamento na mesma venda.',
  },
  {
    title: 'Feche o dia sem susto',
    text: 'Cada venda baixa o estoque e entra no caixa do operador. No fim do dia, confira o valor contado e veja os relatórios.',
  },
];
---

<section id="como-funciona" class="border-y border-line bg-surface py-20 sm:py-28">
  <div class="container-page">
    <div class="max-w-2xl">
      <p class="eyebrow mb-4">Como funciona</p>
      <h2 class="section-title">Do cadastro ao fechamento do caixa, sem trocar de sistema</h2>
      <p class="mt-5 text-lg leading-relaxed text-muted">
        Você entra pelo navegador, cadastra o que vende e já pode atender. Tudo o que acontece no balcão aparece
        no estoque, no caixa e nos relatórios.
      </p>
    </div>

    <ol class="mt-14 grid gap-5 md:grid-cols-3">
      {
        steps.map((s, i) => (
          <li class="relative rounded-3xl border border-line bg-bg p-7">
            <span class="font-mono text-sm font-semibold text-primary">Passo {i + 1}</span>
            <h3 class="mt-3 font-display text-2xl font-bold tracking-tight">{s.title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{s.text}</p>
          </li>
        ))
      }
    </ol>

    <h3 class="mt-24 font-display text-3xl font-bold tracking-tight sm:text-4xl">O que você controla no Organizae</h3>

    <div class="mt-10 grid gap-5 md:grid-cols-6">
      <!-- Vendas -->
      <article class="feature md:col-span-4">
        <div class="feature-body">
          <h4 class="feature-title">Vendas (PDV)</h4>
          <p class="feature-text">
            Busca rápida que encontra "cafe" e "Café", só mostra o que tem em estoque e aceita vários pagamentos
            na mesma venda. Precisa corrigir? Edite a venda e o histórico guarda o que mudou. Trocas também ficam
            registradas.
          </p>
        </div>
        <div class="mock" aria-hidden="true">
          <div class="flex items-center gap-2 rounded-xl border border-line bg-surface px-3 py-2.5 text-sm text-muted">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
            <span class="text-ink">cafe</span><span class="ml-auto font-mono text-xs">2 resultados</span>
          </div>
          <ul class="mt-2 divide-y divide-line rounded-xl border border-line bg-surface text-sm">
            <li class="flex justify-between px-3 py-2.5"><span>Café especial 250g</span><span class="font-mono text-muted">12 un.</span></li>
            <li class="flex justify-between px-3 py-2.5"><span>Caneca Café &amp; Prosa</span><span class="font-mono text-muted">4 un.</span></li>
          </ul>
          <div class="mt-3 flex flex-wrap gap-2 font-mono text-xs">
            <span class="rounded-full bg-primary-soft px-2.5 py-1 text-primary">Pix</span>
            <span class="rounded-full bg-primary-soft px-2.5 py-1 text-primary">Dinheiro</span>
            <span class="rounded-full bg-primary-soft px-2.5 py-1 text-primary">Cartão</span>
          </div>
        </div>
      </article>

      <!-- Caixa -->
      <article class="feature md:col-span-2">
        <div class="feature-body">
          <h4 class="feature-title">Controle de caixa</h4>
          <p class="feature-text">
            Cada operador abre e fecha o próprio caixa. No fechamento, o sistema compara o que era esperado com o
            que foi contado.
          </p>
        </div>
        <div class="mock font-mono text-sm" aria-hidden="true">
          <div class="flex justify-between"><span class="text-muted">Esperado</span><span>R$ 860,00</span></div>
          <div class="flex justify-between"><span class="text-muted">Contado</span><span>R$ 860,00</span></div>
          <div class="mt-2 flex justify-between border-t border-dashed border-line pt-2 font-semibold text-accent"><span>Diferença</span><span>R$ 0,00</span></div>
        </div>
      </article>

      <!-- Estoque -->
      <article class="feature md:col-span-3">
        <div class="feature-body">
          <h4 class="feature-title">Estoque e entrada por NF-e</h4>
          <p class="feature-text">
            Importe o XML da nota de compra: o fornecedor é reconhecido, os itens são ligados aos seus produtos e
            os custos atualizados. Acompanhe as movimentações e receba alerta de estoque baixo.
          </p>
        </div>
        <div class="mock text-sm" aria-hidden="true">
          <div class="flex items-center gap-3 rounded-xl border border-dashed border-primary/50 bg-primary-soft/50 px-3 py-3">
            <span class="grid h-9 w-9 place-items-center rounded-lg bg-primary font-mono text-[0.625rem] font-bold text-primary-ink">XML</span>
            <div class="min-w-0">
              <p class="truncate font-medium">NF-e 4512 · Distribuidora Sol</p>
              <p class="font-mono text-xs text-muted">8 itens · 6 vinculados · 2 novos</p>
            </div>
          </div>
          <div class="mt-2 flex items-center justify-between rounded-xl border border-line bg-surface px-3 py-2.5">
            <span>Vela aromática</span>
            <span class="rounded-full bg-tag px-2 py-0.5 font-mono text-xs font-semibold text-tag-ink">estoque baixo · 2</span>
          </div>
        </div>
      </article>

      <!-- Relatórios -->
      <article class="feature md:col-span-3">
        <div class="feature-body">
          <h4 class="feature-title">Relatórios</h4>
          <p class="feature-text">
            Vendas por período, cliente, produto ou categoria. Fechamentos de caixa, despesas e o comparativo de
            vendas × despesas para saber se o mês fechou no azul.
          </p>
        </div>
        <div class="mock" aria-hidden="true">
          <div class="flex h-28 items-end gap-2.5">
            {
              // Full class names (not interpolated) so Tailwind can see them; inline styles would break the CSP.
              [
                ['h-[62%]', 'h-[30%]'],
                ['h-[74%]', 'h-[34%]'],
                ['h-[58%]', 'h-[28%]'],
                ['h-[86%]', 'h-[36%]'],
                ['h-[92%]', 'h-[40%]'],
                ['h-[80%]', 'h-[33%]'],
              ].map(([sales, expenses]) => (
                <div class="flex h-full flex-1 items-end gap-1">
                  <span class:list={['w-full rounded-t-md bg-primary', sales]} />
                  <span class:list={['w-full rounded-t-md bg-accent/60', expenses]} />
                </div>
              ))
            }
          </div>
          <div class="mt-3 flex gap-4 font-mono text-xs text-muted">
            <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-sm bg-primary"></span>Vendas</span>
            <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-sm bg-accent/60"></span>Despesas</span>
          </div>
        </div>
      </article>

      <!-- Small cards -->
      <article class="feature-sm md:col-span-2">
        <h4 class="feature-title">Cadastros</h4>
        <p class="feature-text">Clientes, produtos, categorias e fornecedores. Preço calculado a partir do custo e da margem padrão da loja.</p>
      </article>
      <article class="feature-sm md:col-span-2">
        <h4 class="feature-title">Despesas</h4>
        <p class="feature-text">Registre aluguel, contas e compras por tipo de despesa e acompanhe quanto sai por mês.</p>
      </article>
      <article class="feature-sm md:col-span-2">
        <h4 class="feature-title">Equipe</h4>
        <p class="feature-text">Usuários com perfil de administrador ou operador. Cada um vê o que precisa para o seu trabalho.</p>
      </article>
    </div>
  </div>
</section>

<style>
  @reference '../styles/global.css';

  .feature {
    @apply flex flex-col justify-between gap-7 overflow-hidden rounded-3xl border border-line bg-bg p-7;
  }
  .feature-sm {
    @apply rounded-3xl border border-line bg-bg p-7;
  }
  .feature-title {
    @apply font-display text-xl font-bold tracking-tight;
  }
  .feature-text {
    @apply mt-2.5 leading-relaxed text-muted;
  }
  .mock {
    @apply rounded-2xl bg-surface-2 p-4;
  }
</style>
