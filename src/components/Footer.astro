---
import Logo from './Logo.astro';
import { NAV, LOGIN_URL, WHATSAPP_URL } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="border-t border-line py-12">
  <div class="container-page flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
    <div class="max-w-xs">
      <Logo />
      <p class="mt-4 text-sm leading-relaxed text-muted">
        Sistema de gestão de lojas: vendas, estoque, caixa e relatórios num só lugar.
      </p>
    </div>
    <nav aria-label="Rodapé" class="grid grid-cols-2 gap-x-14 gap-y-3 text-sm">
      {NAV.map((n) => <a href={n.href} class="text-muted hover:text-ink">{n.label}</a>)}
      <a href={LOGIN_URL} class="text-muted hover:text-ink">Entrar no sistema</a>
      <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="text-muted hover:text-ink">WhatsApp</a>
    </nav>
  </div>
  <div class="container-page mt-10">
    <p class="border-t border-line pt-6 font-mono text-xs text-muted">© {year} Organizae. Todos os direitos reservados.</p>
  </div>
</footer>
