---
import { FAQ, WHATSAPP_URL } from '../config/site';
---

<section id="faq" class="border-t border-line bg-surface py-20 sm:py-28">
  <div class="container-page grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
    <div>
      <p class="eyebrow mb-4">FAQ</p>
      <h2 class="section-title">Perguntas frequentes</h2>
      <p class="mt-5 text-lg leading-relaxed text-muted">
        Não encontrou o que procurava?
        <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="font-semibold text-primary underline underline-offset-4">
          Pergunte pelo WhatsApp
        </a>.
      </p>
    </div>

    <div class="divide-y divide-line border-y border-line">
      {
        FAQ.map(({ q, a }) => (
          <details class="faq group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-left font-display text-lg font-semibold tracking-tight sm:text-xl">
              <h3>{q}</h3>
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-line text-muted transition-transform duration-200 group-open:rotate-45 group-open:border-primary group-open:text-primary">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" aria-hidden="true">
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </span>
            </summary>
            <p class="max-w-2xl pb-6 pr-12 leading-relaxed text-muted">{a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }
</style>
