---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { LOGIN_URL } from '../config/site';
---

<Base title="Página não encontrada — Organizae" path="/404" noindex>
  <main class="container-page grid min-h-dvh place-items-center py-16 text-center">
    <div class="max-w-md">
      <a href="/" aria-label="Organizae — página inicial"><Logo class="justify-center" /></a>
      <p class="mt-10 font-mono text-sm font-semibold text-primary">Erro 404</p>
      <h1 class="mt-3 font-display text-4xl font-extrabold tracking-tight">Esta página não existe</h1>
      <p class="mt-4 text-muted">
        O endereço pode ter mudado. Se você procurava o sistema, ele agora fica em
        <a href={LOGIN_URL} class="font-semibold text-primary underline underline-offset-4">painel.organizae.app.br</a>.
      </p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/" class="btn btn-primary h-12 px-6">Ir para o site</a>
        <a href={LOGIN_URL} class="btn btn-ghost h-12 px-6">Entrar no sistema</a>
      </div>
    </div>
  </main>
</Base>
